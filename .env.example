# Copy to .env and fill in. Never commit .env.
DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-openssl-rand-base64-32"

# ---- Multi-user access ----
REGISTRATION_MODE=invite          # open | invite | closed
INVITE_EMAILS=you@example.com     # comma-separated (used when mode=invite)

# ---- Telegram expense bot (optional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=          # comma-separated numeric ids
BOT_USER_EMAIL=you@example.com
SUPPORT_EMAIL=you@example.com
